# Include local config
Include config.local

# Allow mixing host FQDN patterns and aliases in config
CanonicalizeHostname yes

Host *-stagging
  LocalCommand phook -e "iterm-profile ssh-caution" -a "iterm-profile"

Host *-prod
  LocalCommand phook -e "iterm-profile ssh-danger" -a "iterm-profile"

Host *
  AddKeysToAgent yes
  UseKeychain yes
  PermitLocalCommand yes
  # Change iterm profile in SSH connections
  LocalCommand iterm-ssh-phook info
