#!/usr/bin/env bash
# Sets up the minimum sanitized environment for dot steps

export DOT; DOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

# shellcheck source=../brew/prefix
source "$DOT/.dot/brew/prefix"
# Brew's ruby ahead of the system's, so gem installs where the user may write
export PATH="$DOT/.dot/dot/bin:$BREWDIR/opt/ruby@3.3/bin:$BREWDIR/bin:/usr/bin:/bin"
