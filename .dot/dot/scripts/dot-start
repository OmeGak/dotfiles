#!/usr/bin/env bash
# Welcomes and initializes submodules

set -e
source "$(dirname "$0")/../env"

git submodule update --init --recursive

echo
echo "   ██████   ██████  ████████ ███████ ██ ██      ███████ ███████"
echo "   ██   ██ ██    ██    ██    ██      ██ ██      ██      ██     "
echo "   ██   ██ ██    ██    ██    █████   ██ ██      █████   ███████"
echo "   ██   ██ ██    ██    ██    ██      ██ ██      ██           ██"
echo "██ ██████   ██████     ██    ██      ██ ███████ ███████ ███████"
echo "                                              Let's do(t) this!"

pprint section "READY TO START?"
pprint step-ok -n "All submodules in place"
