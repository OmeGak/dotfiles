#!/usr/bin/env bash
# Checks and install dependencies for the install step
source "$(dirname "$0")/../env"

pprint section 'CHECKING CORE DEPENDENCIES'

# Prepare logs
logsuffix='.install.dep.dot.log'
find -L /tmp -maxdepth 1 -name "*${logsuffix}" -delete

# Find and run dependency install scripts, system and brew first; they are
# read on fd 3 so that stdin stays the terminal for the installers
errors=()
while IFS= read -r -u 3 script; do
  # Refresh environment before each topic
  source "$(dirname "$0")/../env"
  topic=$(basename "$(dirname "${script}")")
  export DOT_TOPIC_LOGFILE_SUFFIX=${topic}${logsuffix}
  pprint step-go "Checking core dependencies from ${topic}..."
  if sh -c "${script}"; then
    pprint info-ok -n "All is ready"
  else
    errors+=("${topic}")
    pprint info-error -n "Missing"
    break
  fi
done 3< <(dotfind "$DOT/.dot" install.dep.sh --priority system brew)

# Show summary
if (( ${#errors[@]} > 0 )); then
  plogs "${logsuffix}" "${errors[@]}"
  exit 1
fi
pprint step-ok -n "All core dependencies are ready"
exit 0
