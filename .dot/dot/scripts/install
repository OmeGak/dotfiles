#!/usr/bin/env bash
# Runs all topic installers
source "$(dirname "$0")/../env"

pprint section 'RUNNING INSTALLERS'

# Prepare logs
logsuffix='.install.dot.log'
find -L /tmp -maxdepth 1 -name "*${logsuffix}" -delete

# Find and run install scripts; they are read on fd 3 so that stdin stays
# the terminal for the installers
errors=()
while IFS= read -r -u 3 script; do
  topic=$(basename "$(dirname "${script}")")
  export DOT_TOPIC_LOGFILE_SUFFIX=${topic}${logsuffix}
  pprint step-go "Installing stuff for ${topic}..."
  if sh -c "${script}"; then
    pprint info-ok -n "All is done"
  else
    errors+=("${topic}")
    pprint info-error -n "Failed"
  fi
done 3< <(dotfind "$DOT" install.sh)

# Show summary
if (( ${#errors[@]} > 0 )); then
  plogs "${logsuffix}" "${errors[@]}"
else
  pprint step-ok -n "Everything installed"
fi

exit 0
