# shellcheck shell=sh
# The Homebrew prefix, as a fact rather than a question to brew: Homebrew's
# installer puts it here by machine, and `brew --prefix` costs a fork of ruby
# on every shell start. POSIX sh: sourced by zsh (zshenv) and bash (dot env).
case "$(uname -m)" in
  arm64) BREWDIR=/opt/homebrew;;
  *) BREWDIR=/usr/local;;
esac
export BREWDIR
