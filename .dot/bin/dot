#!/usr/bin/env bash
# Runs a step of the dotfiles, a script in .dot/dot/scripts, with the words
# after it passed on untouched: `dot install python zsh`. Works from a bare
# clone, before anything is linked, on the bash macOS ships.

export DOT; DOT=$(cd "$(dirname "$0")/../.." && pwd)
# What sudoplz -k keeps sudo alive for: one password covers a whole chain
export DOTPID=$$
scripts="$DOT/.dot/dot/scripts"

usage() {
  cat <<EOF
Usage: dot <step> [words ...]

  setup                a fresh Mac: link, install with root, set the shell
  run [topic ...]      link, then install the core and the topics
  link [--check]       link each topic's files into place; with --check,
                       say what would change, touching nothing
  install [topic ...]  install the core's packages, then the topics'
  setshell             set zsh as the shell
  macos                apply the macOS defaults
  edit                 open the dotfiles in \$DOTEDITOR
  ztrace               time the zsh startup
EOF
}

# -- Steps --------------------------------------------------------------------

# The gitconfig is generated, not linked, so a check leaves it out
# shellcheck disable=SC2120  # the words come through the case below
link() {
  [[ ${1:-} == --check ]] || "${scripts}/link-git" || return
  "${scripts}/link" "$@"
}

# A clean environment, so the install sees the machine as a new shell would
install() {
  env -i HOME="$HOME" DOTPID="$DOTPID" "${scripts}/install" "$@"
}

setshell() {
  "${scripts}/setshell"
}

macos() {
  "${scripts}/macos" "$@"
}

edit() {
  exec $DOTEDITOR "$DOT"
}

ztrace() {
  DOT_ZTRACE=true zsh -ci exit
  ztraceprof
}

# -- Chains -------------------------------------------------------------------

run() {
  link && install "$@"
}

setup() {
  "${scripts}/dot-start" && link && install --sudo && setshell \
    && "${scripts}/dot-finish"
}

# -- Go dot! ------------------------------------------------------------------

step=${1:-}
shift 2> /dev/null
case "${step}" in
  setup|run|link|install|setshell|macos|edit|ztrace)
    "${step}" "$@";;
  '')
    usage 1>&2
    exit 1;;
  *)
    echo "No step ${step}" 1>&2
    usage 1>&2
    exit 1;;
esac
