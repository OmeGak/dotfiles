#!/usr/bin/env bash
# Entry point to control dotfiles operations

# -- Helpers ------------------------------------------------------------------

edit() {
  exec $DOTEDITOR $DOT
}

profile() {
  DOT_ZTRACE=true zsh -ci exit
  ztraceprof
}

case "$1" in
  edit)
    edit
    exit 0;;
  profile)
    profile
    exit 0;;
  *)
    ;;
esac


# -- Go dot! ------------------------------------------------------------------

# The words after the target reach the step as ARGS: `dot install python zsh`
command make -C "$DOT" --no-print-directory ${1:+"$1"} ARGS="${*:2}"
