#!/usr/bin/env bash
# Tests the Homebrew prefix fact under each machine kind, in bash and zsh,
# with a fake uname on PATH and no startup files (-f: ~/.zshenv would rebuild
# PATH). Plain bash, no runner: the exit code is the result.

set -u
prefix=$(cd "$(dirname "$0")/../.." && pwd)/brew/prefix
fake=$(mktemp -d "${TMPDIR:-/tmp}/prefix-test.XXXXXX")
failed=0

# A uname that answers the given machine
fake_uname() {
  printf '#!/bin/sh\necho %s\n' "$1" > "${fake}/uname"
  chmod +x "${fake}/uname"
}

# expect <uname -m> <prefix>
expect() {
  local shell got
  fake_uname "$1"
  for shell in bash zsh; do
    got=$(PATH="${fake}:$PATH" "${shell}" -f -c "source '${prefix}'; echo \$BREWDIR")
    if [[ "${got}" == "$2" ]]; then
      printf -- '- %s in %s: %s\n' "$1" "${shell}" "${got}"
    else
      printf -- '- %s in %s: FAIL, got %s, expected %s\n' "$1" "${shell}" "${got}" "$2"
      failed=1
    fi
  done
}

expect arm64 /opt/homebrew
expect x86_64 /usr/local

rm -rf "${fake}"
if (( failed )); then
  echo "prefix: some tests failed"
  exit 1
fi
echo "prefix: all tests passed"
