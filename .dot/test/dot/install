#!/usr/bin/env bash
# Tests the install step against a fake dotfiles folder: the real .dot core
# with its installers replaced by fixtures and pinstall by a fake, and a few
# fixture topics, whose installers only write their name to a trace and
# exit as told. Plain bash, no runner: each `it` is a test, each `expect_*`
# an assertion, the exit code is the result.

set -u
repo=$(cd "$(dirname "$0")/../../.." && pwd)
failed=0

# -- Fixtures -----------------------------------------------------------------

# An installer that appends its topic to the trace, leaves the logs of a
# failed run and a fine one when asked, as prun names them, and exits with
# the given code
installer() {
  local path=$1 code=${2:-0} log=${3:-}
  mkdir -p "$(dirname "${path}")"
  {
    echo '#!/usr/bin/env bash'
    echo "echo \"$(basename "$(dirname "${path}")")\" >> \"${tmp}/trace\""
    [[ ${log} ]] && echo "echo failed > \"/tmp/${log}.failed.\$DOT_TOPIC_LOGFILE_SUFFIX\""
    [[ ${log} ]] && echo "echo fine > \"/tmp/fine.\$DOT_TOPIC_LOGFILE_SUFFIX\""
    echo "exit ${code}"
  } > "${path}"
  chmod +x "${path}"
}

# An installer as a topic writes one, without an exit of its own: its lines
# after the trace one
plain_installer() {
  local path=$1
  shift
  mkdir -p "$(dirname "${path}")"
  {
    echo '#!/usr/bin/env bash'
    echo "echo \"$(basename "$(dirname "${path}")")\" >> \"${tmp}/trace\""
    printf '%s\n' "$@"
  } > "${path}"
  chmod +x "${path}"
}

# A manifest with the given lines; one with "fail" in it fails
manifest() {
  local path=$1
  shift
  mkdir -p "$(dirname "${path}")"
  printf '%s\n' "$@" > "${path}"
}

# A pinstall that appends <topic>/packages to the trace and, with --check,
# reports every line of the manifest as missing
fake_pinstall() {
  cat > "$DOT/.dot/dot/bin/pinstall" <<EOF
#!/usr/bin/env bash
check=
if [[ \$1 == --check ]]; then check=1; shift; fi
topic=\$(basename "\$(dirname "\$2")")
if [[ \${check} ]]; then
  grep -v '^#' "\$2" | grep . && exit 1
  exit 0
fi
echo "\${topic}/packages" >> "${tmp}/trace"
grep -q fail "\$2" && exit 1
exit 0
EOF
  chmod +x "$DOT/.dot/dot/bin/pinstall"
}

# A sudoplz that traces the ask the step makes before it says whether root
# is allowed, is silent once it has (the credential is cached), and skips
# as the real one does when the run has no root
fake_sudoplz() {
  cat > "$DOT/.dot/dot/bin/sudoplz" <<EOF
#!/usr/bin/env bash
reason=
while getopts 'ksr:' o; do [[ \$o == r ]] && reason=\$OPTARG; done
if [[ \${DOT_SUDO:-} == no ]]; then
  echo "Needs sudo for \${reason} (dot install --sudo)"
  exit 1
fi
[[ \${DOT_SUDO:-} ]] || echo sudoplz >> "${tmp}/trace"
EOF
  chmod +x "$DOT/.dot/dot/bin/sudoplz"
}

# An installer with a root part behind sudoplz, as the rule has them
root_installer() {
  local path=$1
  mkdir -p "$(dirname "${path}")"
  {
    echo '#!/usr/bin/env bash'
    echo "echo \"$(basename "$(dirname "${path}")")\" >> \"${tmp}/trace\""
    echo "sudoplz -r 'a root thing' || exit 0"
    echo "echo root >> \"${tmp}/trace\""
  } > "${path}"
  chmod +x "${path}"
}

# A fresh fake dotfiles folder: the real core without its installers, fixture
# core topics (alpha sorts before brew, to show brew still goes first) and
# fixture topics (beta fails and leaves a log, delta has only a manifest,
# empty has nothing)
fresh() {
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/install-test.XXXXXX")
  tmp=$(cd "${tmp}" && pwd)
  export HOME="${tmp}/home"
  DOT="${tmp}/dotfiles"
  mkdir -p "$HOME" "$DOT"
  cp -R "${repo}/.dot" "$DOT/.dot"
  rm -f "$DOT"/.dot/*/install.sh "$DOT"/.dot/*/packages
  fake_pinstall
  fake_sudoplz
  installer "$DOT/.dot/brew/install.sh"
  installer "$DOT/.dot/alpha/install.sh"
  installer "$DOT/.dot/zeta/install.sh"
  installer "$DOT/alpha/install.sh"
  installer "$DOT/beta/install.sh" 1 fixture
  manifest "$DOT/delta/packages" "brew fd"
  installer "$DOT/gamma/install.sh"
  mkdir -p "$DOT/empty"
  install="$DOT/.dot/dot/scripts/install"
  rm -f /tmp/*.beta.install.dot.log
}

# Runs the install step as make does, in a sanitized env
run_install() {
  TERM=dumb env -i HOME="$HOME" "${install}" "$@" > "${tmp}/out" 2>&1
  code=$?
  out=$(cat "${tmp}/out")
  trace=$(cat "${tmp}/trace" 2> /dev/null | tr '\n' ' ')
}

# -- Assertions ---------------------------------------------------------------

it() {
  printf '%s\n' "- $1"
}

fail() {
  printf '    FAIL: %s\n' "$1"
  failed=1
}

expect_trace() {
  [[ ${trace} == "${1:+$1 }" ]] || fail "ran '${trace}', expected '$1'"
}

expect_code() {
  [[ ${code} -eq $1 ]] || fail "exit code ${code}, expected $1"
}

expect_output() {
  [[ ${out} == *"$1"* ]] || fail "output lacks '$1':"$'\n'"${out}"
}

expect_no_output() {
  [[ ${out} != *"$1"* ]] || fail "output has '$1':"$'\n'"${out}"
}

# -- Tests --------------------------------------------------------------------

it "runs the core first, brew ahead, then the topics"
fresh
run_install
expect_trace "brew alpha zeta alpha beta delta/packages gamma"
expect_output "INSTALLING CORE"
expect_output "INSTALLING TOPICS"

it "runs a topic's manifest before its installer"
fresh
manifest "$DOT/alpha/packages" "brew bat"
manifest "$DOT/.dot/zeta/packages" "brew zsh"
run_install alpha
expect_code 0
expect_trace "brew alpha zeta/packages zeta alpha/packages alpha"

it "keeps going after a topic fails and reports it with its failed logs only"
fresh
run_install
expect_code 0
expect_output "There were some errors in: beta"
expect_output "/tmp/fixture.failed.beta.install.dot.log"
expect_no_output "/tmp/fine.beta.install.dot.log"

it "marks a topic failed when its manifest fails"
fresh
manifest "$DOT/epsilon/packages" "brew fail-me"
run_install epsilon
expect_code 0
expect_output "There were some errors in: epsilon"

it "marks a topic failed when a try in its installer fails, and runs the rest"
fresh
plain_installer "$DOT/kappa/install.sh" "try false" "echo after >> \"${tmp}/trace\""
run_install kappa
expect_code 0
expect_trace "brew alpha zeta kappa after"
expect_output "There were some errors in: kappa"

it "marks a topic failed when its installer's last command fails, without try"
fresh
plain_installer "$DOT/kappa/install.sh" "false"
run_install kappa
expect_code 0
expect_output "There were some errors in: kappa"

it "says everything is installed when nothing fails"
fresh
rm "$DOT/beta/install.sh"
run_install
expect_code 0
expect_output "Everything installed"
expect_no_output "errors"

it "stops at a core failure before any topic, with exit 1"
fresh
installer "$DOT/.dot/brew/install.sh" 1
run_install
expect_code 1
expect_trace "brew"
expect_output "There were some errors in: brew"

it "installs only the named topics, after the whole core"
fresh
run_install gamma alpha
expect_code 0
expect_trace "brew alpha zeta alpha gamma"

it "says so for a named topic without an installer"
fresh
run_install empty
expect_code 0
expect_trace "brew alpha zeta"
expect_output "Nothing to install for empty"

it "refuses an unknown topic before running anything"
fresh
run_install alpha nope
expect_code 1
expect_trace ""
expect_output "No topic nope"

it "clears a topic's old logs before running it"
fresh
echo stale > /tmp/old.alpha.install.dot.log
run_install alpha
[[ -e /tmp/old.alpha.install.dot.log ]] && fail "old log still there"
rm -f /tmp/old.alpha.install.dot.log

it "asks for sudo once before anything with --sudo, and the root parts run"
fresh
root_installer "$DOT/rho/install.sh"
run_install --sudo rho
expect_code 0
expect_trace "sudoplz brew alpha zeta rho root"
expect_no_output "Needs sudo"

it "asks nothing without --sudo and skips the root parts, saying so"
fresh
root_installer "$DOT/rho/install.sh"
run_install rho
expect_code 0
expect_trace "brew alpha zeta rho"
expect_output "Needs sudo for a root thing (dot install --sudo)"
expect_no_output "errors"

it "refuses an unknown option"
fresh
run_install --nope
expect_code 1
expect_trace ""
expect_output "No option --nope"

it "says what each manifest is missing with --check, installing and asking nothing"
fresh
manifest "$DOT/alpha/packages" "# Tools" "brew bat"
manifest "$DOT/theta/packages" "# Nothing"
run_install --sudo --check
expect_code 0
expect_trace ""
expect_output "CHECKING CORE"
expect_output "CHECKING TOPICS"
expect_output "Missing for alpha:"
expect_output "brew bat"
expect_output "Missing for delta:"
expect_output "Nothing missing for theta"
expect_no_output "INSTALLING"

it "checks only the named topics, after the core"
fresh
manifest "$DOT/.dot/zeta/packages" "brew zsh"
run_install --check delta
expect_code 0
expect_output "Missing for zeta:"
expect_output "Missing for delta:"
expect_no_output "alpha"

exit "${failed}"
