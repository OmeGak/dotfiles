#!/usr/bin/env bash
# Tests the install step against a fake dotfiles folder: the real .dot core
# with its installers replaced by fixtures, and a few fixture topics, whose
# installers only write their name to a trace and exit as told. Plain bash,
# no runner: each `it` is a test, each `expect_*` an assertion, the exit code
# is the result.

set -u
repo=$(cd "$(dirname "$0")/../../.." && pwd)
failed=0

# -- Fixtures -----------------------------------------------------------------

# An installer that appends its topic to the trace, writes a log when asked,
# and exits with the given code
installer() {
  local path=$1 code=${2:-0} log=${3:-}
  mkdir -p "$(dirname "${path}")"
  {
    echo '#!/usr/bin/env bash'
    echo "echo \"$(basename "$(dirname "${path}")")\" >> \"${tmp}/trace\""
    [[ ${log} ]] && echo "echo failed > \"/tmp/${log}.\$DOT_TOPIC_LOGFILE_SUFFIX\""
    echo "exit ${code}"
  } > "${path}"
  chmod +x "${path}"
}

# A fresh fake dotfiles folder: the real core without its installers, fixture
# core topics (alpha sorts before brew, to show brew still goes first) and
# fixture topics (beta fails and leaves a log, empty has no installer)
fresh() {
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/install-test.XXXXXX")
  tmp=$(cd "${tmp}" && pwd)
  export HOME="${tmp}/home"
  DOT="${tmp}/dotfiles"
  mkdir -p "$HOME" "$DOT"
  cp -R "${repo}/.dot" "$DOT/.dot"
  rm -f "$DOT"/.dot/*/install.sh
  installer "$DOT/.dot/system/install.sh"
  installer "$DOT/.dot/brew/install.sh"
  installer "$DOT/.dot/alpha/install.sh"
  installer "$DOT/.dot/zeta/install.sh"
  installer "$DOT/alpha/install.sh"
  installer "$DOT/beta/install.sh" 1 fixture
  installer "$DOT/gamma/install.sh"
  mkdir -p "$DOT/empty"
  install="$DOT/.dot/dot/scripts/install"
  rm -f /tmp/*.beta.install.dot.log
}

# Runs the install step as make does, in a sanitized env
run_install() {
  TERM=dumb env -i HOME="$HOME" "${install}" "$@" > "${tmp}/out" 2>&1
  code=$?
  out=$(cat "${tmp}/out")
  trace=$(cat "${tmp}/trace" 2> /dev/null | tr '\n' ' ')
}

# -- Assertions ---------------------------------------------------------------

it() {
  printf '%s\n' "- $1"
}

fail() {
  printf '    FAIL: %s\n' "$1"
  failed=1
}

expect_trace() {
  [[ ${trace} == "${1:+$1 }" ]] || fail "ran '${trace}', expected '$1'"
}

expect_code() {
  [[ ${code} -eq $1 ]] || fail "exit code ${code}, expected $1"
}

expect_output() {
  [[ ${out} == *"$1"* ]] || fail "output lacks '$1':"$'\n'"${out}"
}

expect_no_output() {
  [[ ${out} != *"$1"* ]] || fail "output has '$1':"$'\n'"${out}"
}

# -- Tests --------------------------------------------------------------------

it "runs the core first, system and brew ahead, then the topics"
fresh
run_install
expect_trace "system brew alpha zeta alpha beta gamma"
expect_output "INSTALLING CORE"
expect_output "INSTALLING TOPICS"

it "keeps going after a topic fails and reports it with its log"
fresh
run_install
expect_code 0
expect_output "There were some errors in: beta"
expect_output "/tmp/fixture.beta.install.dot.log"

it "says everything is installed when nothing fails"
fresh
rm "$DOT/beta/install.sh"
run_install
expect_code 0
expect_output "Everything installed"
expect_no_output "errors"

it "stops at a core failure before any topic, with exit 1"
fresh
installer "$DOT/.dot/brew/install.sh" 1
run_install
expect_code 1
expect_trace "system brew"
expect_output "There were some errors in: brew"

it "installs only the named topics, after the whole core"
fresh
run_install gamma alpha
expect_code 0
expect_trace "system brew alpha zeta alpha gamma"

it "says so for a named topic without an installer"
fresh
run_install empty
expect_code 0
expect_trace "system brew alpha zeta"
expect_output "Nothing to install for empty"

it "refuses an unknown topic before running anything"
fresh
run_install alpha nope
expect_code 1
expect_trace ""
expect_output "No topic nope"

it "clears a topic's old logs before running it"
fresh
echo stale > /tmp/old.alpha.install.dot.log
run_install alpha
[[ -e /tmp/old.alpha.install.dot.log ]] && fail "old log still there"
rm -f /tmp/old.alpha.install.dot.log

exit "${failed}"
